# Copy to .env. Every value below is a placeholder.

PORT=3000

# PostgreSQL. TypeORM creates and updates the tables on start (synchronize: true).
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_NAME=project_management

# Signs access and password-reset tokens. Required: the app refuses to start without it.
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1d

# SMTP server for verification codes and password-reset links.
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=replace-me
MAIL_PASS=replace-me
MAIL_FROM=no-reply@example.com
